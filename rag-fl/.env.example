# ================================================================================
# RAG-FL Environment Configuration
# ================================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control (it's in .gitignore)
# ================================================================================

# ── Google Cloud API ────────────────────────────────────────────────────────
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# ── AI Models ───────────────────────────────────────────────────────────────
# Embedding model (768-dim, asymmetric task types)
# Options: models/gemini-embedding-001 | models/text-embedding-004
EMBEDDING_MODEL=models/gemini-embedding-001

# Vision model (multimodal page analysis)
# Options: gemini-2.0-flash | gemini-1.5-flash
VISION_MODEL=gemini-2.0-flash

# ── MongoDB Configuration ───────────────────────────────────────────────────
# MONGODB ATLAS CLOUD
# Get your connection string from: https://cloud.mongodb.com → Database → Connect
# IMPORTANT: Install pymongo[srv]==4.7: pip install "pymongo[srv]==4.7"
MONGODB_URI=mongodb+srv://username:password@cluster0.jnoqx4p.mongodb.net/?appName=Cluster0
MONGODB_DB=ragfl

# ── Vector Search Backend ───────────────────────────────────────────────────
# Options: atlas | local
#   atlas = Use MongoDB Atlas $vectorSearch
#   local = Use Python cosine similarity (fallback)
VECTOR_SEARCH_BACKEND=atlas

# ── Google Cloud Storage ────────────────────────────────────────────────────
# Development (fake-gcs): http://fake-gcs:4443
# Production: https://storage.googleapis.com
GCS_ENDPOINT=http://fake-gcs:4443
GCS_BUCKET=rag-fl-documents

# ── Redis Configuration ─────────────────────────────────────────────────────
# Development (Docker): redis://redis:6379
# Production (Cloud Memorystore): redis://your-memorystore-ip:6379
REDIS_URL=redis://redis:6379

# ── Application Environment ─────────────────────────────────────────────────
# development | production
# Note: This affects logging, error handling, etc.
# Vector search is controlled separately by VECTOR_SEARCH_BACKEND
ENVIRONMENT=development

# Threshold for dry-run warnings (number of Gemini Vision calls)
DRY_RUN_THRESHOLD=10

# ── File System Paths ───────────────────────────────────────────────────────
# Use absolute paths. Examples:
# macOS/Linux: /Users/username/work/rag-fl/input
# Windows: E:/Work/Embedding Projects POC/input
INPUT_DIR=/Users/username/work/rag-fl/input
OUTPUT_DIR=/Users/username/work/rag-fl/output

# ── Service Ports ───────────────────────────────────────────────────────────
INGESTION_PORT=8001
RAG_FL_PORT=8004

# ── External Services ───────────────────────────────────────────────────────
# Gotenberg (LibreOffice headless for PPTX/DOCX conversion)
LIBREOFFICE_URL=http://libreoffice:3000

# Ingestion service URL (used by watcher.py for auto-processing)
# Development: http://localhost:8001/ingest
# Production: http://ingestion:8001/ingest (Docker network) or https://ingest.domain.com/ingest
INGEST_URL=http://localhost:8001/ingest

# ── Phase 3 Pipeline Configuration ──────────────────────────────────────────
# false = full classification (production default, zero cost)
# true  = skip classification, treat all PDF pages as "mixed" (fast dev mode)
FORCE_MIXED_MODE=false

# ── Phase 4.1 & Phase 5 Citation Configuration ──────────────────────────────
# Base URLs for citation deep links
# Development: localhost URLs
# Production: real domain URLs
CITATION_RAG_FL_BASE=http://localhost:8004
CITATION_UI_BASE=http://localhost:3001

# ── UI Configuration (Next.js) ──────────────────────────────────────────────
# These are injected into browser-side JavaScript
# MUST use localhost for development (browser can't access Docker network)
# Production: replace with real domain URLs
NEXT_PUBLIC_RAG_FL_API=http://localhost:8004
NEXT_PUBLIC_INGESTION_API=http://localhost:8001

# ── CORS Configuration ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS (rag-fl service)
# Development: localhost URLs
# Production: replace with real domain URLs (e.g., https://app.domain.com,https://admin.domain.com)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ================================================================================
# Security Best Practices
# ================================================================================
# ✅ DO:
#   - Keep .env file outside version control (.gitignore)
#   - Use docker-compose `env_file: .env` (NOT build-time ARG)
#   - Use Google Secret Manager for production (Cloud Run, GKE)
#   - Rotate API keys regularly
#   - Use service accounts instead of API keys when possible
#
# ❌ DON'T:
#   - Hardcode API keys in source code
#   - Commit .env to Git
#   - Use same API key for dev/staging/production
#   - Share API keys via Slack/email
#   - Build .env values into Docker images (use runtime injection)
# ================================================================================

# ================================================================================
# MongoDB Local Atlas Setup Instructions
# ================================================================================
# 1. Install Atlas CLI:
#    brew install mongodb-atlas-cli
#
# 2. Create local deployment:
#    atlas deployments setup localRS
#    - Choose "Local" deployment type
#    - MongoDB version: 7.0.12 (or latest)
#    - Port: 27017
#    - Replica set name: localRS
#
# 3. Create vector search index:
#    atlas deployments search indexes create --file infra/atlas/vector-index.json --deploymentName localRS
#
# 4. (Optional) Connect with mongosh:
#    atlas deployments connect localRS
#
# 5. Start Docker services (without MongoDB):
#    docker compose up -d
#
# ================================================================================

# ================================================================================
# Production Checklist (Phase 7 - Cloud Run Migration)
# ================================================================================
# [ ] GOOGLE_API_KEY → Google Secret Manager
# [ ] MONGODB_URI → MongoDB Atlas connection string (M10+ for $vectorSearch)
# [ ] VECTOR_SEARCH_BACKEND=atlas (already set)
# [ ] GCS_ENDPOINT → https://storage.googleapis.com
# [ ] REDIS_URL → Cloud Memorystore IP:port
# [ ] ENVIRONMENT=production
# [ ] NEXT_PUBLIC_RAG_FL_API → https://api.yourdomain.com
# [ ] NEXT_PUBLIC_INGESTION_API → https://ingest.yourdomain.com
# [ ] CITATION_RAG_FL_BASE → https://api.yourdomain.com
# [ ] CITATION_UI_BASE → https://app.yourdomain.com
# ================================================================================
