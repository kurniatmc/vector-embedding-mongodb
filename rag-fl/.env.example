# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  copy to .env and fill in real values
# All variables are REQUIRED unless marked [optional]
# ─────────────────────────────────────────────────────────────────────────────

# ── Google AI API ─────────────────────────────────────────────────────────────
# Used for: text-embedding-004 (Phase 5) and Gemini Vision Flash (Phase 5)
GOOGLE_API_KEY=your-google-api-key-here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: always use replicaSet=rs0 (required even for single-node)
# Production: replace with Atlas connection string
MONGODB_URI=mongodb://mongo:27017/ragfl?replicaSet=rs0
MONGODB_DB=ragfl

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# Local dev: fake-gcs-server (HTTP on port 4443)
# Production: https://storage.googleapis.com
GCS_ENDPOINT=http://fake-gcs:4443
GCS_BUCKET=rag-fl-documents

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Runtime ───────────────────────────────────────────────────────────────────
# development  → local cosine similarity, fake-gcs, verbose logging
# production   → Atlas $vectorSearch, real GCS, structured JSON logs
ENVIRONMENT=development

# Max Gemini Vision calls before pausing and requiring confirmation
# Local: 10  |  Production: 100
DRY_RUN_THRESHOLD=10

# ── Bind Mounts — Windows paths (forward slashes, spaces OK) ─────────────────
# These are exposed inside containers as /input and /output
INPUT_DIR=E:/Work/TMC - Roshn/Work/Embedding Projects POC/input
OUTPUT_DIR=E:/Work/TMC - Roshn/Work/Embedding Projects POC/output

# ── Service Ports (host-side) ─────────────────────────────────────────────────
INGESTION_PORT=8001
LEDGER_PORT=8002
ANALYZER_PORT=8003
RAG_FL_PORT=8004
SEARCH_PORT=8005
CITATION_PORT=8006

# ── Inter-service URLs (container-to-container, do not change for local dev) ──
LIBREOFFICE_URL=http://libreoffice:3000
